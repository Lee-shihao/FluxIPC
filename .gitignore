# ── Build output ─────────────────────────────────────────
build/
.tools/

# Built binaries (root-anchored)
/fluxipc-cli
/fluxipc-ut
/fluxipc-ut-asan
/fluxipc-it
/example_server
/example_client

# Local toolchain / package artifacts
*.deb

# ── Coverage / profiling artifacts ───────────────────────
*.gcov
*.gcda
*.gcno
*.profraw
*.profdata

# ── Compilation database (regenerate with `make compdb`) ─
compile_commands.json

# ── Compiled objects and libraries ───────────────────────
*.o
*.a
*.so
*.so.*
*.dylib

# ── Generated pkg-config ─────────────────────────────────
fluxipc.pc

# ── Python ───────────────────────────────────────────────
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Editor and OS files ──────────────────────────────────
*~
*.swp
*.orig
*.rej
.DS_Store
.clangd/

# ── Crash dumps ──────────────────────────────────────────
core
core.*
*.core

# ── Local caches ─────────────────────────────────────────
.cache/

# Claude Code local settings (personal, not shared)
.claude/settings.local.json

# Graphify - 核心文件保留，临时/中间文件忽略
graphify-out/cache/
graphify-out/cost.json
graphify-out/*.log

# Graphify 中间/临时文件
graphify-out/.graphify_*.json
graphify-out/.graphify_python
graphify-out/.graphify_root
